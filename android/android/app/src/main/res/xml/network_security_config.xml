<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (SECURITY.md). LAN party HTTP is added in M8. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
